{
  "compilerOptions": {
    "target": "ES2019",
    "module": "none",
    "lib": [
      "DOM",
      "ES2019"
    ],
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "removeComments": false,
    "outFile": "dist/main.js"
  },
  "files": [
    "src/types.ts",
    "src/constants.ts",
    "src/math.ts",
    "src/state.ts",
    "src/dom.ts",
    "src/render.ts",
    "src/main.ts"
  ]
}
